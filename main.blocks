<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="k;_.d]sP`8a%S-*g-K:R">strip</variable>
    <variable id="turn-dir">turn</variable>
  </variables>
  <block type="device_button_event" id="btnA" x="20" y="20">
    <field name="NAME">Button.A</field>
    <statement name="HANDLER">
      <block type="variables_set" id="setLeft">
        <field name="VAR" id="turn-dir">turn</field>
        <value name="VALUE">
          <shadow type="math_number" id="zeroLeft">
            <field name="NUM">0</field>
          </shadow>
          <block type="math_number" id="numLeft">
            <field name="NUM">-1</field>
          </block>
        </value>
        <next>
          <block type="basic_show_arrow" id="arrowLeft">
            <value name="i">
              <shadow type="device_arrow" id="arrowLeftShadow">
                <field name="arrow">ArrowNames.West</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="device_button_event" id="btnB" x="20" y="220">
    <field name="NAME">Button.B</field>
    <statement name="HANDLER">
      <block type="variables_set" id="setRight">
        <field name="VAR" id="turn-dir">turn</field>
        <value name="VALUE">
          <shadow type="math_number" id="zeroRight">
            <field name="NUM">0</field>
          </shadow>
          <block type="math_number" id="numRight">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="basic_show_arrow" id="arrowRight">
            <value name="i">
              <shadow type="device_arrow" id="arrowRightShadow">
                <field name="arrow">ArrowNames.East</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="pxt-on-start" id="onStart" x="420" y="20">
    <statement name="HANDLER">
      <block type="radio_set_group" id="setGroup">
        <value name="ID">
          <shadow type="math_number" id="groupNum">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <next>
          <block type="radio_datagram_send" id="helloRadio">
            <value name="value">
              <shadow type="math_number" id="helloNum">
                <field name="NUM">876</field>
              </shadow>
            </value>
            <next>
              <block type="record_startRecording" id="recordClip">
                <field name="mode">record.BlockingState.Nonblocking</field>
                <next>
                  <block type="smarthon_iot_bit_initialize_wifi" id="wifiInit">
                    <field name="txPin">SerialPin.P16</field>
                    <field name="rxPin">SerialPin.P8</field>
                    <next>
                      <block type="basic_show_icon" id="iconDiamond">
                        <field name="i">IconNames.SmallDiamond</field>
                        <next>
                          <block type="basic_show_icon" id="iconNo">
                            <field name="i">IconNames.No</field>
                            <next>
                              <block type="basic_show_icon" id="iconHappy">
                                <field name="i">IconNames.Happy</field>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="device_forever" id="driveLoop" x="20" y="460">
    <statement name="HANDLER">
      <block type="controls_if" id="steerIf">
        <mutation elseif="1" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="cmpLeft">
            <field name="OP">LT</field>
            <value name="A">
              <block type="variables_get" id="getTurnLeft">
                <field name="VAR" id="turn-dir">turn</field>
              </block>
            </value>
            <value name="B">
              <shadow type="math_number" id="cmpLeftZero">
                <field name="NUM">0</field>
              </shadow>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="kitronik_servolite_turn_left" id="doLeft">
            <value name="deg">
              <shadow type="math_number" id="leftDeg">
                <field name="NUM">45</field>
              </shadow>
            </value>
            <next>
              <block type="variables_set" id="clearLeft">
                <field name="VAR" id="turn-dir">turn</field>
                <value name="VALUE">
                  <shadow type="math_number" id="clearLeftNum">
                    <field name="NUM">0</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <value name="IF1">
          <block type="logic_compare" id="cmpRight">
            <field name="OP">GT</field>
            <value name="A">
              <block type="variables_get" id="getTurnRight">
                <field name="VAR" id="turn-dir">turn</field>
              </block>
            </value>
            <value name="B">
              <shadow type="math_number" id="cmpRightZero">
                <field name="NUM">0</field>
              </shadow>
            </value>
          </block>
        </value>
        <statement name="DO1">
          <block type="kitronik_servolite_turn_right" id="doRight">
            <value name="deg">
              <shadow type="math_number" id="rightDeg">
                <field name="NUM">45</field>
              </shadow>
            </value>
            <next>
              <block type="variables_set" id="clearRight">
                <field name="VAR" id="turn-dir">turn</field>
                <value name="VALUE">
                  <shadow type="math_number" id="clearRightNum">
                    <field name="NUM">0</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="kitronik_servolite_drive_forwards" id="drive">
            <value name="howFar">
              <shadow type="math_number" id="driveDist">
                <field name="NUM">10</field>
              </shadow>
            </value>
            <next>
              <block type="device_pause" id="drivePause">
                <value name="pause">
                  <shadow type="math_number" id="pauseMs">
                    <field name="NUM">100</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="variables_set" id="setStrip">
            <field name="VAR" id="k;_.d]sP`8a%S-*g-K:R">strip</field>
            <value name="VALUE">
              <shadow type="math_number" id="stripZero">
                <field name="NUM">0</field>
              </shadow>
              <block type="sonar_ping" id="ping">
                <field name="trig">DigitalPin.P0</field>
                <field name="echo">DigitalPin.P0</field>
                <field name="unit">PingUnit.Centimeters</field>
              </block>
            </value>
            <next>
              <block type="radio_datagram_send" id="sendDist">
                <value name="value">
                  <shadow type="math_number" id="sendShadow">
                    <field name="NUM">0</field>
                  </shadow>
                  <block type="variables_get" id="getStrip">
                    <field name="VAR" id="k;_.d]sP`8a%S-*g-K:R">strip</field>
                  </block>
                </value>
                <next>
                  <block type="dataloggerlog" id="logRow" inline="true">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation>
                    <value name="data1">
                      <shadow type="dataloggercreatecolumnvalue" id="cv1shadow">
                        <value name="column">
                          <shadow type="datalogger_columnfield" id="col1shadow">
                            <field name="column">cm</field>
                          </shadow>
                        </value>
                        <value name="value">
                          <shadow type="math_number" id="val1shadow">
                            <field name="NUM">0</field>
                          </shadow>
                        </value>
                      </shadow>
                      <block type="dataloggercreatecolumnvalue" id="cv1">
                        <value name="column">
                          <shadow type="datalogger_columnfield" id="col1">
                            <field name="column">cm</field>
                          </shadow>
                        </value>
                        <value name="value">
                          <shadow type="math_number" id="val1">
                            <field name="NUM">0</field>
                          </shadow>
                          <block type="variables_get" id="logStrip">
                            <field name="VAR" id="k;_.d]sP`8a%S-*g-K:R">strip</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="data2">
                      <shadow type="dataloggercreatecolumnvalue" id="cv2shadow">
                        <value name="column">
                          <shadow type="datalogger_columnfield" id="col2shadow">
                            <field name="column"></field>
                          </shadow>
                        </value>
                        <value name="value">
                          <shadow type="math_number" id="val2shadow">
                            <field name="NUM">0</field>
                          </shadow>
                        </value>
                      </shadow>
                      <block type="dataloggercreatecolumnvalue" id="cv2">
                        <value name="column">
                          <shadow type="datalogger_columnfield" id="col2">
                            <field name="column">line</field>
                          </shadow>
                        </value>
                        <value name="value">
                          <shadow type="math_number" id="val2">
                            <field name="NUM">0</field>
                          </shadow>
                          <block type="Environment_doubleTrackingValue" id="track">
                            <field name="pin1">DigitalPin.P0</field>
                            <field name="pin2">DigitalPin.P0</field>
                            <field name="state">Environment.TrackingStateType.Tracking_State_0</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
